{
	"name": "get-covers",
	"version": "1.1.0",
	"description": "Search for a cover image for the current note and assign it to the note's cover frontmatter property.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"deploy": "node scripts/deploy.mjs",
		"build:deploy": "npm run build && npm run deploy",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"cover"
	],
	"author": "Cover Search",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "^0.20.0",
		"obsidian": "^1.4.11",
		"tslib": "^2.6.2",
		"typescript": "^5.4.0"
	},
	"allowScripts": {
		"esbuild@0.20.2": true
	}
}
